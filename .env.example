# Copy to .env for local development. Never commit .env or real secrets (NFR-11).
# `docker compose up` works without a .env: every value below has the same default there.

# --- Postgres (docker compose) ---
POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla
POSTGRES_DB=tesla_pool
POSTGRES_PORT=5432

# --- Host ports published by docker compose ---
API_PORT=4000
WEB_PORT=3000

# --- API, when run on the host with `npm run dev -w @tesla-pool/api` ---
# Inside compose the API gets its own DATABASE_URL pointing at the `db` service.
DATABASE_URL=postgres://tesla:tesla@localhost:5432/tesla_pool
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Signs the login cookie (min 32 chars). Use a long random value anywhere real, e.g.
# `node -e "console.log(crypto.randomBytes(32).toString('base64url'))"`.
SESSION_SECRET=local-dev-only-session-secret-change-me
# Secure cookies need HTTPS. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false

# --- Tests: a separate database, created automatically on the first run ---
TEST_DATABASE_URL=postgres://tesla:tesla@localhost:5432/tesla_pool_test

# --- Web: where the Next.js proxy sends /api/v1/* (read at build time) ---
API_URL=http://localhost:4000
